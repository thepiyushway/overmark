{
  "name": "overmark",
  "productName": "Overmark",
  "version": "1.0.0-beta.1",
  "description": "Draw on anything on your screen, highlight and spotlight your cursor, and zoom. A free, open-source screen annotation menu bar app for macOS.",
  "author": "thepiyushway",
  "license": "MIT",
  "homepage": "https://github.com/thepiyushway/overmark",
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-page.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:arm64": "npm run sync && electron-builder --mac dmg --arm64 --publish never",
    "test": "npm run sync && node ../tests/standalone_e2e.js && node ../tests/features_e2e.js",
    "test:flow": "npm run sync && node ../tests/standalone_e2e.js",
    "test:features": "npm run sync && node ../tests/features_e2e.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "playwright-core": "1.49.1"
  },
  "build": {
    "appId": "app.overmark.Overmark",
    "productName": "Overmark",
    "copyright": "\u00a9 2026 thepiyushway. MIT License.",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterSign": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Overmark does not control other apps."
      },
      "artifactName": "Overmark-${version}-${arch}-mac.${ext}",
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Overmark ${version}",
      "artifactName": "Overmark-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "publish": null
  }
}
